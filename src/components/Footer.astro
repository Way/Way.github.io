---
import SvgDefs from './SvgDefs.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-foot">
  <hr class="rule-heavy" />
  <div class="row">
    <span>© {year} {SITE_TITLE} · {SITE_DESCRIPTION}</span>
    <nav aria-label="Rechtliches und Links">
      <a href="/impressum">Impressum</a>
      <a href="/datenschutz">Datenschutz</a>
      <a href="/rss.xml">RSS</a>
      <a href="https://x.com/dailyway" target="_blank" rel="noopener">X</a>
      <a href="https://github.com/way" target="_blank" rel="noopener">GitHub</a>
    </nav>
  </div>
  <SvgDefs />
</footer>

<style>
  .site-foot { margin-top: 56px; padding-bottom: 48px; }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 24px;
    padding-top: 12px;
    font-family: var(--font-sans);
    font-size: 12.5px;
    color: var(--muted);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    font-weight: 700;
    color: var(--ink);
  }
</style>
