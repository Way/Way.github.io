---
interface Props {
  items?: string[];
  question?: string;
  variant?: 'full' | 'row' | 'stack';
}

const { items = [], question, variant = 'full' } = Astro.props;
---

{
  (items.length > 0 || question) && (
    <aside class:list={['glance', `glance--${variant}`]} aria-label="Auf einen Blick">
      {items.length > 0 && (
        <>
          <span class="label">Auf einen Blick</span>
          <ol>
            {items.map((item) => (
              <li>{item}</li>
            ))}
          </ol>
        </>
      )}
      {question && (
        <div class="question">
          <span class="label">Leitfrage</span>
          <p>{question}</p>
        </div>
      )}
    </aside>
  )
}

<style>
  .label { color: var(--ink); display: block; }
  ol { list-style: none; margin: 0; padding: 0; }

  .glance--full {
    border-top: 3px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
    padding-block: 12px 18px;
    align-self: start;
  }
  .glance--full ol { counter-reset: t; margin-top: 8px; }
  .glance--full li {
    counter-increment: t;
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 8px;
    padding-block: 11px;
    border-bottom: 1px solid var(--rule);
    font-size: 16px;
    line-height: 1.45;
  }
  .glance--full li::before {
    content: counter(t);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    color: var(--kicker);
    padding-top: 3px;
  }
  .question { margin-top: 14px; }
  .question p { margin-top: 6px; font-size: 18px; line-height: 1.4; font-style: italic; }

  .glance--row,
  .glance--stack {
    border-top: 2px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule);
    padding-block: 10px 16px;
  }
  .glance--row .label,
  .glance--stack .label { margin-bottom: 10px; }
  .glance--row ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 20px; }
  .glance--row li {
    font-size: 15.5px;
    line-height: 1.42;
    padding-left: 20px;
    border-left: 1px solid var(--rule);
  }
  .glance--row li:first-child { padding-left: 0; border-left: 0; }
  .glance--stack li {
    padding-block: 8px;
    border-top: 1px solid var(--rule);
    font-size: 15px;
    line-height: 1.42;
  }
  .glance--stack li:first-child { border-top: 0; padding-top: 0; }

  @media (max-width: 640px) {
    .glance--row ol { grid-template-columns: 1fr; }
    .glance--row li { padding-left: 0; border-left: 0; padding-block: 8px; border-top: 1px solid var(--rule); }
    .glance--row li:first-child { border-top: 0; padding-top: 0; }
  }
</style>
