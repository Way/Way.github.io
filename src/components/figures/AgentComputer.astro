---
import Figure from './Figure.astro';

interface Props {
  number?: number;
  layout?: 'stack' | 'split';
}

const { number, layout } = Astro.props;
---

<Figure
  number={number}
  layout={layout}
  title="Wer bedient die Software? Der Assistent sitzt zwischen dir und dem Anbieter"
  source="Quelle: Produktangaben zu Grok Bot (xAI, 11. August 2026) und Muse (Meta, 8. September 2026), wie im Beitrag zitiert. Schema, keine Messwerte."
>
  <p slot="text">Ein Chatbot erklärt dir den Weg. Ein Assistent mit eigenem Rechner geht ihn selbst, beim Händler über die Oberfläche und bei der Bank über eine von zwei Türen.</p>
  <svg class="grafik wide" viewBox="0 0 520 232" role="img" aria-labelledby="fig-agent-t">
    <title id="fig-agent-t">Du gibst dem Assistenten einen Auftrag, er fragt vor Versand oder Zahlung nach Freigabe. Der Assistent arbeitet auf einem eigenen Rechner in der Cloud mit Browser, Dateien, Gedächtnis und deinen Logins. Er bedient die Oberfläche des Händlers. Zur Bank führen zwei Wege: eine Schnittstelle mit echter Zustimmung oder ein geliehener Browser, also Screen Scraping.</title>
    <rect x="4" y="80" width="80" height="64" class="ln fl-paper"></rect>
    <text x="44" y="104" font-size="11.5" text-anchor="middle" class="t-strong">DU</text>
    <text x="44" y="121" font-size="11" text-anchor="middle" class="t-muted">diktierst,</text>
    <text x="44" y="134" font-size="11" text-anchor="middle" class="t-muted">gibst frei</text>

    <line x1="84" y1="100" x2="134" y2="100" class="ln" marker-end="url(#ah)"></line>
    <text x="109" y="93" font-size="10.5" text-anchor="middle" class="t-muted">Auftrag</text>
    <line x1="134" y1="126" x2="84" y2="126" class="ln ln-d" marker-end="url(#ah)"></line>
    <text x="109" y="142" font-size="10.5" text-anchor="middle" class="t-muted">Freigabe?</text>

    <rect x="136" y="20" width="178" height="180" class="ln ln-b w15 fl-tint"></rect>
    <text x="150" y="42" font-size="11.5" class="t-strong t-blue">ASSISTENT</text>
    <text x="150" y="58" font-size="11" class="t-muted">eigener Rechner in der Cloud</text>
    <rect x="150" y="72" width="72" height="54" class="ln fl-paper"></rect>
    <rect x="228" y="72" width="72" height="54" class="ln fl-paper"></rect>
    <rect x="150" y="132" width="72" height="54" class="ln fl-paper"></rect>
    <rect x="228" y="132" width="72" height="54" class="ln fl-paper"></rect>
    <text x="186" y="103" font-size="12" text-anchor="middle">Browser</text>
    <text x="264" y="103" font-size="12" text-anchor="middle">Dateien</text>
    <text x="186" y="163" font-size="12" text-anchor="middle">Gedächtnis</text>
    <text x="264" y="163" font-size="12" text-anchor="middle">Logins</text>
    <text x="225" y="222" font-size="11" text-anchor="middle" class="t-ital t-muted">arbeitet weiter, wenn der Laptop zu ist</text>

    <rect x="420" y="20" width="96" height="58" class="ln fl-paper"></rect>
    <text x="468" y="44" font-size="11.5" text-anchor="middle" class="t-strong">HÄNDLER</text>
    <text x="468" y="61" font-size="11" text-anchor="middle" class="t-muted">Rücksendung</text>
    <line x1="314" y1="49" x2="418" y2="49" class="ln" marker-end="url(#ah)"></line>
    <text x="366" y="41" font-size="10.5" text-anchor="middle" class="t-muted">Oberfläche</text>

    <rect x="420" y="124" width="96" height="76" class="ln fl-paper"></rect>
    <text x="468" y="150" font-size="11.5" text-anchor="middle" class="t-strong">BANK</text>
    <text x="468" y="168" font-size="11" text-anchor="middle" class="t-muted">Open Banking</text>
    <text x="468" y="182" font-size="11" text-anchor="middle" class="t-muted">nach PSD2</text>
    <line x1="314" y1="142" x2="418" y2="142" class="ln ln-b w15" marker-end="url(#ahb)"></line>
    <text x="366" y="134" font-size="10.5" text-anchor="middle" class="t-blue">API mit Zustimmung</text>
    <line x1="314" y1="182" x2="418" y2="182" class="ln ln-d" marker-end="url(#ah)"></line>
    <text x="366" y="174" font-size="10.5" text-anchor="middle" class="t-muted">geliehener Browser</text>
    <text x="366" y="197" font-size="10.5" text-anchor="middle" class="t-muted">= Screen Scraping</text>
  </svg>
</Figure>
