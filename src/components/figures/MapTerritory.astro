---
import Figure from './Figure.astro';

interface Props {
  number?: number;
}

const { number } = Astro.props;
---

<Figure
  number={number}
  title="Die Karte ist nicht das Gebiet"
  source="Quelle: Alfred Korzybski (1931); die Übertragung auf die Arbeit mit KI-Agenten nach Thariq. Darstellung nach dem Beitrag."
>
  <svg class="grafik wide" viewBox="0 0 520 236" role="img" aria-labelledby="fig-map-t">
    <title id="fig-map-t">Links die Karte: Prompts, Kontext und Pläne. Auf ihr arbeitet die Maschine, Metrik, Testfall und Vorgabe sind abgehakt. Rechts das Gebiet mit Codebase, Produkt und Nutzer, und mit allem, was nie jemand aufschreibt. Zwischen beiden steht ein Ungleichzeichen.</title>
    <text x="16" y="20" font-size="11.5" class="t-strong">DIE KARTE</text>
    <rect x="16" y="30" width="210" height="150" class="ln fl-paper"></rect>
    <g class="ln-grid">
      <line x1="51" y1="30" x2="51" y2="180"></line><line x1="86" y1="30" x2="86" y2="180"></line><line x1="121" y1="30" x2="121" y2="180"></line><line x1="156" y1="30" x2="156" y2="180"></line><line x1="191" y1="30" x2="191" y2="180"></line>
      <line x1="16" y1="60" x2="226" y2="60"></line><line x1="16" y1="90" x2="226" y2="90"></line><line x1="16" y1="120" x2="226" y2="120"></line><line x1="16" y1="150" x2="226" y2="150"></line>
    </g>
    <rect x="34" y="54" width="12" height="12" class="ln fl-paper"></rect>
    <path d="M36.5 60.5 l3 3 l5 -6.5" class="ln ln-b w15"></path>
    <text x="56" y="64" font-size="12.5">Metrik</text>
    <rect x="34" y="92" width="12" height="12" class="ln fl-paper"></rect>
    <path d="M36.5 98.5 l3 3 l5 -6.5" class="ln ln-b w15"></path>
    <text x="56" y="102" font-size="12.5">Testfall</text>
    <rect x="34" y="130" width="12" height="12" class="ln fl-paper"></rect>
    <path d="M36.5 136.5 l3 3 l5 -6.5" class="ln ln-b w15"></path>
    <text x="56" y="140" font-size="12.5">Vorgabe</text>
    <text x="210" y="168" font-size="11" text-anchor="end" class="t-blue">alle Häkchen grün</text>
    <text x="16" y="202" font-size="11" class="t-muted">Prompts · Kontext · Pläne</text>
    <text x="16" y="220" font-size="11">Hier arbeitet die Maschine.</text>
    <text x="260" y="118" font-size="40" text-anchor="middle" class="t-serif">≠</text>
    <text x="294" y="20" font-size="11.5" class="t-strong">DAS GEBIET</text>
    <path d="M314 58 C332 34 380 38 404 44 C436 52 470 32 492 56 C510 78 502 110 496 130 C488 160 470 182 436 177 C404 172 384 184 352 178 C320 172 296 154 300 126 C304 102 292 82 314 58 Z" class="ln w15 fl-paper"></path>
    <path d="M334 72 C350 56 384 60 404 64 C430 70 458 58 474 74 C486 90 480 112 474 128 C466 150 450 160 426 157 C402 154 386 162 360 158 C336 154 320 140 322 122 C324 104 318 88 334 72 Z" class="ln-grid ln-d"></path>
    <circle cx="340" cy="84" r="2.5" class="fl-ink"></circle><text x="348" y="88" font-size="12.5">Codebase</text>
    <circle cx="424" cy="98" r="2.5" class="fl-ink"></circle><text x="432" y="102" font-size="12.5">Produkt</text>
    <circle cx="356" cy="128" r="2.5" class="fl-ink"></circle><text x="364" y="132" font-size="12.5">Nutzer</text>
    <text x="410" y="160" font-size="11.5" text-anchor="middle" class="t-ital t-muted">was nie jemand aufschreibt</text>
    <text x="294" y="202" font-size="11" class="t-muted">echte Codebase · Produkt · Nutzer</text>
    <text x="294" y="220" font-size="11">Hier lebt, was gut ist und sich lohnt.</text>
  </svg>
</Figure>
