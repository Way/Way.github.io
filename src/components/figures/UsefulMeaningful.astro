---
import Figure from './Figure.astro';

interface Props {
  number?: number;
  layout?: 'stack' | 'split';
}

const { number, layout } = Astro.props;
---

<Figure
  number={number}
  layout={layout}
  title="Der Unterbau wandert zur Maschine, der Wert wandert nach oben"
  source="Quelle: Alex Vey, „Das Nützliche und das Bedeutsame“, 10. Juli 2026; das Bild vom Bürgeramt nach Dan Koe. Schema, keine Messwerte."
>
  <Fragment slot="text">
    <p>Unten liegt das Nützliche: Arbeit, die erledigt werden muss und die man gern abgibt. Sie schrumpft auf einen kleinen Rest.</p>
    <p>Oben liegt das Bedeutsame. Es bleibt beim Menschen, weil am Ende ein Mensch mit seinem Namen dafür einsteht.</p>
  </Fragment>
  <svg class="grafik wide" viewBox="0 0 520 372" role="img" aria-labelledby="fig-useful-t">
    <title id="fig-useful-t">Gestapeltes Schema. Oben das Bedeutsame mit Urteil, Geschmack und Vertrauen, es bleibt beim Menschen. Unten das Nützliche mit Code schreiben, Tests, Pull Request, Rechnungen und Termine, es wandert zur Maschine und schrumpft auf einen kleinen Rest. Ein Pfeil links zeigt: Der Wert wandert nach oben.</title>
    <line x1="20" y1="352" x2="20" y2="32" class="ln" marker-end="url(#ah)"></line>
    <text transform="translate(12 192) rotate(-90)" font-size="10.5" text-anchor="middle" class="t-strong t-muted">WERT WANDERT NACH OBEN</text>
    <rect x="44" y="28" width="318" height="136" class="ln ln-b w15 fl-tint"></rect>
    <text x="56" y="50" font-size="11.5" class="t-strong t-blue">DAS BEDEUTSAME</text>
    <rect x="56" y="62" width="92" height="90" class="ln fl-paper"></rect>
    <rect x="156" y="62" width="92" height="90" class="ln fl-paper"></rect>
    <rect x="256" y="62" width="92" height="90" class="ln fl-paper"></rect>
    <text x="102" y="94" font-size="16" text-anchor="middle" class="t-serif">Urteil</text>
    <text x="202" y="94" font-size="16" text-anchor="middle" class="t-serif">Geschmack</text>
    <text x="302" y="94" font-size="16" text-anchor="middle" class="t-serif">Vertrauen</text>
    <g font-size="11" text-anchor="middle" class="t-muted">
      <text x="102" y="118" class="t-muted">lohnt sich</text><text x="102" y="132" class="t-muted">die Sache?</text>
      <text x="202" y="118" class="t-muted">was ist hier</text><text x="202" y="132" class="t-muted">wirklich gut?</text>
      <text x="302" y="118" class="t-muted">wem überlasse</text><text x="302" y="132" class="t-muted">ich die Aufgabe?</text>
    </g>
    <text x="203" y="193" font-size="12.5" text-anchor="middle" class="t-ital t-muted">je billiger das Nützliche, desto wertvoller das Darüber</text>
    <rect x="44" y="212" width="318" height="140" class="ln ln-d"></rect>
    <text x="56" y="234" font-size="11.5" class="t-strong">DAS NÜTZLICHE</text>
    <g class="ln ln-d fl-paper">
      <rect x="56" y="246" width="54" height="56"></rect><rect x="116" y="246" width="54" height="56"></rect><rect x="176" y="246" width="54" height="56"></rect><rect x="236" y="246" width="54" height="56"></rect><rect x="296" y="246" width="54" height="56"></rect>
    </g>
    <g font-size="11" text-anchor="middle">
      <text x="83" y="271">Code</text><text x="83" y="284">schreiben</text>
      <text x="143" y="278">Tests</text>
      <text x="203" y="271">Pull</text><text x="203" y="284">Request</text>
      <text x="263" y="271">Rech-</text><text x="263" y="284">nungen</text>
      <text x="323" y="278">Termine</text>
    </g>
    <rect x="56" y="318" width="40" height="22" class="fl-ink"></rect>
    <text x="106" y="333" font-size="11" class="t-muted">schrumpft auf einen kleinen Rest</text>
    <line x1="362" y1="107" x2="410" y2="107" class="ln w15"></line>
    <text x="386" y="100" font-size="10.5" text-anchor="middle" class="t-muted">bleibt</text>
    <rect x="410" y="62" width="106" height="90" class="ln w15 fl-paper"></rect>
    <text x="463" y="88" font-size="11.5" text-anchor="middle" class="t-strong">MENSCH</text>
    <g font-size="11" text-anchor="middle">
      <text x="463" y="108" class="t-muted">steht mit</text><text x="463" y="122" class="t-muted">seinem Namen</text><text x="463" y="136" class="t-muted">dafür ein</text>
    </g>
    <line x1="362" y1="274" x2="408" y2="274" class="ln ln-b w15" marker-end="url(#ahb)"></line>
    <text x="386" y="266" font-size="10.5" text-anchor="middle" class="t-blue">wandert</text>
    <rect x="410" y="246" width="106" height="56" class="ln fl-paper"></rect>
    <text x="463" y="268" font-size="11.5" text-anchor="middle" class="t-strong">MASCHINE</text>
    <g font-size="11" text-anchor="middle">
      <text x="463" y="284" class="t-muted">günstig, rund</text><text x="463" y="296" class="t-muted">um die Uhr</text>
    </g>
  </svg>
</Figure>
