---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Glance from '../components/Glance.astro';
import { FIGURES } from '../components/figures';
import { RESSORTS } from '../consts';
import type { Post } from '../lib/posts';

type Props = Partial<CollectionEntry<'blog'>['data']> & {
  title: string;
  description: string;
  image?: string;
  readingMinutes?: number;
  related?: Post[];
  page?: boolean;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  prompt,
  ressort,
  kicker,
  tags = [],
  glance,
  figure,
  image,
  readingMinutes,
  related = [],
  page = false,
} = Astro.props;

const ressortName = ressort ? RESSORTS[ressort] : undefined;
const kickerText = kicker ?? ressortName;
const LeadFigure = figure ? FIGURES[figure] : undefined;
const hasGlance = !page && ((glance && glance.length > 0) || Boolean(prompt));
---

<html lang="de">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      imageAlt={image && kickerText ? `${kickerText}: ${title}` : undefined}
      article={
        !page && pubDate && ressortName
          ? { publishedTime: pubDate, modifiedTime: updatedDate, section: ressortName, tags, readingMinutes }
          : undefined
      }
    />
  </head>
  <body>
    <div class="page">
      <Header />
      <main>
        <article>
          <header class:list={['grid-12', 'art-head', { 'art-head--page': page }]}>
            <div class:list={[hasGlance ? 'col-8' : 'col-12']}>
              {kickerText && <span class="kicker">{kickerText}</span>}
              <h1>{title}</h1>
              {description && !page && <p class="dek">{description}</p>}
              {
                !page && pubDate && (
                  <p class="byline source">
                    <b>Von Alex Vey</b>
                    <FormattedDate date={pubDate} />
                    {updatedDate && (
                      <span>
                        aktualisiert <FormattedDate date={updatedDate} />
                      </span>
                    )}
                    {readingMinutes && <span>{readingMinutes} Min. Lesezeit</span>}
                  </p>
                )
              }
            </div>
            {
              hasGlance && (
                <div class="col-4">
                  <Glance items={glance} question={prompt} variant="full" />
                </div>
              )
            }
          </header>

          {
            LeadFigure && (
              <>
                <hr class="rule-thin" />
                <div class="art-fig">
                  <LeadFigure number={1} layout="split" />
                </div>
              </>
            )
          }

          <hr class="rule-thin" />

          <div class="grid-12 art-body">
            <div class="col-8 post-body">
              <slot />
            </div>
            {
              !page && (
                <aside class="col-4 rail" aria-label="Zum Beitrag">
                  <dl class="facts">
                    {ressortName && (
                      <div>
                        <dt>Ressort</dt>
                        <dd>{ressortName}</dd>
                      </div>
                    )}
                    {pubDate && (
                      <div>
                        <dt>Erschienen</dt>
                        <dd>
                          <FormattedDate date={pubDate} />
                        </dd>
                      </div>
                    )}
                    {readingMinutes && (
                      <div>
                        <dt>Lesezeit</dt>
                        <dd>{readingMinutes} Min.</dd>
                      </div>
                    )}
                  </dl>
                  {tags.length > 0 && (
                    <div class="tags">
                      <span class="label">Stichworte</span>
                      <p>{tags.join(' · ')}</p>
                    </div>
                  )}
                </aside>
              )
            }
          </div>

          {
            related.length > 0 && (
              <section class="further" aria-labelledby="weiterlesen">
                <hr class="rule-mid" />
                <div class="section-head">
                  <h2 id="weiterlesen">Weiterlesen</h2>
                </div>
                <div class="grid-12 further-grid">
                  {related.map((post, i) => (
                    <article class:list={['col-4', { divided: i > 0 }]}>
                      <span class="kicker">{post.data.kicker ?? RESSORTS[post.data.ressort]}</span>
                      <h3>
                        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                      </h3>
                      <p>{post.data.description}</p>
                      <span class="source">
                        <FormattedDate date={post.data.pubDate} />
                      </span>
                    </article>
                  ))}
                </div>
              </section>
            )
          }
        </article>
        <div id="img-zoom-overlay" class="img-zoom-overlay"></div>
      </main>
      <Footer />
    </div>

    <style>
      .art-head { padding-block: 30px 34px; row-gap: 28px; }
      .art-head--page { padding-bottom: 20px; }
      h1 {
        font-size: clamp(38px, 6vw, 74px);
        line-height: 1;
        letter-spacing: -0.022em;
      }
      .art-head .dek { font-size: clamp(19px, 1.8vw, 22px); margin-top: 18px; }
      .byline {
        margin-top: 18px;
        display: flex;
        flex-wrap: wrap;
        gap: 4px 14px;
      }
      .byline b { color: var(--ink); }

      .art-fig { padding-block: 16px 30px; }

      .art-body { padding-block: 30px 10px; }
      .rail {
        align-self: start;
        position: sticky;
        top: 24px;
        display: flex;
        flex-direction: column;
        gap: 22px;
      }
      .facts { margin: 0; border-top: 2px solid var(--rule-strong); }
      .facts div {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding-block: 8px;
        border-bottom: 1px solid var(--rule);
        font-family: var(--font-sans);
        font-size: 13px;
      }
      .facts dt { color: var(--muted); font-weight: 500; }
      .facts dd { margin: 0; font-weight: 600; text-align: right; }
      .tags { border-top: 1px solid var(--rule-strong); padding-top: 10px; }
      .tags p { margin-top: 6px; font-size: 15px; line-height: 1.5; color: var(--ink-soft); }

      .further { margin-top: 44px; }
      .further-grid { padding-block: 16px 8px; }
      .further h3 { font-size: 22px; line-height: 1.15; }
      .further p {
        margin-block: 8px 10px;
        font-size: 15.5px;
        line-height: 1.5;
        color: var(--ink-soft);
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .further .source { display: block; }

      @media (max-width: 960px) {
        .rail { position: static; margin-top: 32px; }
        .further article + article { margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--rule); }
      }

      .post-body :global(.heading-anchor) {
        font-family: var(--font-sans);
        font-weight: 500;
        font-size: 0.6em;
        color: var(--muted);
        text-decoration: none;
        margin-left: 0.5rem;
        padding: 0 0.25rem;
        opacity: 0;
        transition: opacity 0.15s, color 0.15s;
        vertical-align: middle;
        position: relative;
        top: -0.1em;
      }
      .post-body :global(h2:hover .heading-anchor),
      .post-body :global(h3:hover .heading-anchor),
      .post-body :global(.heading-anchor:focus-visible) {
        opacity: 1;
      }
      .post-body :global(.heading-anchor:hover) { color: var(--kicker); }
      .post-body :global(.heading-anchor.copied)::after {
        content: 'kopiert';
        position: absolute;
        left: calc(100% + 0.4rem);
        top: 50%;
        transform: translateY(-50%);
        font-size: 0.65rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--kicker);
        white-space: nowrap;
      }

      .post-body :global(img),
      .post-body :global(figure) {
        cursor: zoom-in;
        transition: transform 0.3s cubic-bezier(0.2, 0, 0.2, 1);
      }
      .img-zoom-overlay {
        position: fixed;
        inset: 0;
        background: rgba(17, 20, 29, 0.82);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s cubic-bezier(0.2, 0, 0.2, 1);
        z-index: 99;
      }
      .img-zoom-overlay.active {
        opacity: 1;
        pointer-events: auto;
        cursor: zoom-out;
      }
      :global(.img-zoomed) {
        position: relative;
        z-index: 100;
        cursor: zoom-out !important;
        background: var(--paper);
        padding: 1rem;
      }
    </style>

    <script>
      function initImageZoom() {
        const overlay = document.getElementById('img-zoom-overlay');
        if (!overlay) return;
        let zoomedEl: HTMLElement | null = null;
        let originalTransform = '';

        function zoomIn(el: HTMLElement) {
          if (zoomedEl) return;
          zoomedEl = el;
          const rect = el.getBoundingClientRect();
          const viewportW = window.innerWidth;
          const viewportH = window.innerHeight;
          const padding = 40;
          const maxW = viewportW - padding * 2;
          const maxH = viewportH - padding * 2;
          let maxNaturalScale = 3;
          if (el instanceof HTMLImageElement) {
            maxNaturalScale = Math.min(
              el.naturalWidth / rect.width,
              el.naturalHeight / rect.height
            );
          }
          const fitScale = Math.min(maxW / rect.width, maxH / rect.height);
          const scale = Math.min(fitScale, maxNaturalScale, 3);
          const imgCenterX = rect.left + rect.width / 2;
          const imgCenterY = rect.top + rect.height / 2;
          const translateX = viewportW / 2 - imgCenterX;
          const translateY = viewportH / 2 - imgCenterY;
          originalTransform = el.style.transform;
          el.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
          el.classList.add('img-zoomed');
          overlay.classList.add('active');
        }

        function zoomOut() {
          if (!zoomedEl) return;
          zoomedEl.style.transform = originalTransform;
          zoomedEl.classList.remove('img-zoomed');
          overlay.classList.remove('active');
          zoomedEl = null;
          originalTransform = '';
        }

        document.querySelectorAll('.post-body img, .post-body figure').forEach((el) => {
          el.addEventListener('click', (e) => {
            e.stopPropagation();
            e.preventDefault();
            const target = el as HTMLElement;
            if (zoomedEl === target) {
              zoomOut();
            } else {
              zoomOut();
              zoomIn(target);
            }
          });
        });

        overlay.addEventListener('click', zoomOut);
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') zoomOut();
        });
      }

      initImageZoom();
      document.addEventListener('astro:after-swap', initImageZoom);

      function initHeadingAnchors() {
        const headings = document.querySelectorAll<HTMLHeadingElement>(
          '.post-body h2[id], .post-body h3[id]'
        );
        headings.forEach((heading) => {
          if (heading.querySelector('.heading-anchor')) return;
          const link = document.createElement('a');
          link.href = `#${heading.id}`;
          link.className = 'heading-anchor';
          link.setAttribute('aria-label', `Direktlink zu „${heading.textContent?.trim() ?? ''}“`);
          link.textContent = '#';
          link.addEventListener('click', async (event) => {
            event.preventDefault();
            const url = `${window.location.origin}${window.location.pathname}#${heading.id}`;
            history.replaceState(null, '', `#${heading.id}`);
            heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
            try {
              if (navigator.clipboard && window.isSecureContext) {
                await navigator.clipboard.writeText(url);
              } else {
                const ta = document.createElement('textarea');
                ta.value = url;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
              }
              link.classList.add('copied');
              window.setTimeout(() => link.classList.remove('copied'), 1500);
            } catch {
              /* ignore — anchor still works */
            }
          });
          heading.appendChild(link);
        });

        if (window.location.hash) {
          const id = decodeURIComponent(window.location.hash.slice(1));
          const target = document.getElementById(id);
          if (target) {
            requestAnimationFrame(() => {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
          }
        }
      }

      initHeadingAnchors();
      document.addEventListener('astro:after-swap', initHeadingAnchors);
    </script>
    </body>
</html>
