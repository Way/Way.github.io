---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getPublishedPosts, readingMinutes, ressortLabel } from '../../lib/posts';

const posts = await getPublishedPosts();
const years = [...new Set(posts.map((p) => p.data.pubDate.getFullYear()))];
const shortDate = (d: Date) =>
  d.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
---

<!doctype html>
<html lang="de">
  <head>
    <BaseHead title={`Archiv · ${SITE_TITLE}`} description={`Alle ${posts.length} Beiträge von Alex Vey.`} />
  </head>
  <body>
    <div class="page">
      <Header />
      <main>
        <header class="archive-head">
          <span class="kicker">Archiv</span>
          <h1>Alle Beiträge</h1>
          <p class="dek">{posts.length} Essays über AI, Software Engineering und Führung. Immer mit Blick auf den Menschen.</p>
        </header>

        {
          years.map((year) => {
            const yearPosts = posts.filter((p) => p.data.pubDate.getFullYear() === year);
            return (
              <section class="year" aria-labelledby={`y${year}`}>
                <div class="year-head">
                  <h2 id={`y${year}`}>{year}</h2>
                  <span class="source">{yearPosts.length} Beiträge</span>
                </div>
                <ol>
                  {yearPosts.map((post) => (
                    <li>
                      <time class="source" datetime={post.data.pubDate.toISOString()}>
                        {shortDate(post.data.pubDate)}
                      </time>
                      <span class="ressort">{ressortLabel(post)}</span>
                      <div class="entry">
                        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                        <p>{post.data.description}</p>
                      </div>
                      <span class="source minutes">{readingMinutes(post)} Min.</span>
                    </li>
                  ))}
                </ol>
              </section>
            );
          })
        }
      </main>
      <Footer />
    </div>

    <style>
      .archive-head { padding-block: 30px 26px; }
      .archive-head h1 {
        font-size: clamp(38px, 6vw, 64px);
        line-height: 1;
        letter-spacing: -0.022em;
      }
      .archive-head .dek { margin-top: 14px; }
      .year { margin-top: 18px; }
      .year-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        border-top: 3px solid var(--rule-strong);
        border-bottom: 1px solid var(--rule-strong);
        padding-block: 8px 6px;
      }
      .year-head h2 { font-size: 28px; font-variant-numeric: tabular-nums; }
      ol { list-style: none; margin: 0; padding: 0; }
      li {
        display: grid;
        grid-template-columns: 7.5em 13em minmax(0, 1fr) 4em;
        gap: 4px 16px;
        align-items: baseline;
        padding-block: 12px;
        border-bottom: 1px solid var(--rule);
      }
      .ressort { font-family: var(--font-sans); font-size: 12.5px; font-weight: 700; color: var(--kicker); }
      .entry a { font-size: 19px; font-weight: 600; line-height: 1.25; }
      .entry p {
        margin-top: 4px;
        font-size: 15px;
        line-height: 1.5;
        color: var(--ink-soft);
        max-width: 70ch;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .minutes { text-align: right; }
      @media (max-width: 760px) {
        li { grid-template-columns: auto minmax(0, 1fr); }
        .entry { grid-column: 1 / -1; }
        .minutes { display: none; }
      }
    </style>
  </body>
</html>
